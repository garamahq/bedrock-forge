# ─── Bedrock Forge — Deployment Configuration ────────────────────────────────
# Copy to .env.deploy and fill in your values.
# This file is NOT committed to git (.env.deploy is gitignored).
#
# Usage: ./deploy.sh

# SSH user on the target server (usually root or a deploy user)
SERVER_USER=root

# Server IP or hostname
SERVER_HOST=your.server.ip.or.hostname

# Absolute path on the server where the project will live
SERVER_PATH=/home/forge

# Public domain (used for CORS_ORIGIN and deployment output)
# Include the scheme: https://forge.example.com
DOMAIN=https://forge.example.com

# ─── Optional ────────────────────────────────────────────────────────────────

# Override the Docker image tag (default: git short-sha, e.g. "a1b2c3d")
# IMAGE_TAG=latest

# Set to "true" to skip the Docker disk-cleanup step after deploying
# DEPLOY_SKIP_DOCKER_CLEANUP=false

# How old builder cache must be before it gets pruned (default 168 h = 7 days)
# DEPLOY_DOCKER_BUILDER_PRUNE_UNTIL=168h

# Number of recent Forge and web image versions retained for rollback (default 3)
# DEPLOY_KEEP_IMAGE_VERSIONS=3

# Set to "true" to install Chromium in the production forge image.
# Required if you want to use the local Lighthouse audit provider.
# If set to "false" (recommended), you can still use the PageSpeed API provider.
# Chromium is required for invoice PDF generation.
INSTALL_CHROMIUM=false

# Set to "true" (default) to skip re-uploading an image if the tag is already present on the server
DEPLOY_SKIP_EXISTING_IMAGE_UPLOAD=true
